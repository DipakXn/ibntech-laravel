.env
.env.*
!.env.example
/public/hot
/.phpunit.cache
/node_modules
/vendor
.tmp-*/
ibntech-laravel.zip

# Filled server deployment config. Commit deploy-config.sh.example only.
/deploy-config.sh

# Historical Elementor exports contain personal form data. Keep them in
# storage/app/old-submissions (outside the public web root) and never commit them.
/storage/app/old-submissions/**
!/storage/app/old-submissions/.gitignore

/public/hot
/public/hot.bak
/storage/*.key
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/*
!/storage/app/.gitignore
!/storage/app/old-submissions/
/storage/app/old-submissions/**
!/storage/app/old-submissions/.gitignore
/storage/media-library/
/storage/public/
/public/uploads/*
!/public/uploads/.gitignore
/.idea
/.vscode
/.fleet
/.nova
/.zed
.DS_Store
Thumbs.db
/.phpunit.result.cache
/error_log
